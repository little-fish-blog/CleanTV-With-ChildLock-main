<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF10141E"
    android:orientation="horizontal"
    android:padding="28dp">

    <!-- 左半区：基础配置与模式管理 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👶 儿童模式与家长管理"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_today_watched"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="今日儿童累计观看：0 分钟"
            android:textColor="#34C759"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. 儿童锁总开关 -->
                <LinearLayout
                    android:id="@+id/row_master_switch"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/settings_row_bg"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="儿童锁总开关"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_master_switch_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已开启"
                        android:textColor="#34C759"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 2. 当前模式手动切换 -->
                <LinearLayout
                    android:id="@+id/row_switch_mode"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/settings_row_bg"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前身份模式切换"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_current_mode_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前为：大人模式"
                        android:textColor="#FFD54F"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 3. 防篡改开关 -->
                <LinearLayout
                    android:id="@+id/row_anti_tamper"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/settings_row_bg"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="时间防篡改保护（默认开启）"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_anti_tamper_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已开启（检测时间被回拨强制锁屏）"
                        android:textColor="#34C759"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 4. 修改密码 -->
                <LinearLayout
                    android:id="@+id/row_change_password"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/settings_row_bg"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="修改家长 4 位 PIN 码"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="默认密码为 1234，点击修改"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 5. 应用白名单 -->
                <LinearLayout
                    android:id="@+id/row_app_whitelist"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/settings_row_bg"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="应用白名单（不计观看时长）"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_app_whitelist_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已选 0 个应用"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 6. 清除冷却限制 -->
                <LinearLayout
                    android:id="@+id/row_reset_cooldown"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/settings_row_bg"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清除当前休息冷却状态"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="如需提前结束孩子休息时间可点此"
                        android:textColor="#9E9E9E"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btn_close_settings"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/emotn_card_bg"
            android:text="↩ 返回桌面"
            android:textColor="@color/menu_item_text_color"
            android:textSize="15sp"
            android:textStyle="bold"
            android:focusable="true" />
    </LinearLayout>

    <!-- 右半区：多规则时段概览 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_menu_bubble"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏰ 管控时段规则"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_add_rule"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/emotn_card_bg"
                android:text="➕ 添加新规则"
                android:textColor="@color/menu_item_text_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="OK键[启停/修改/删除]；管控时间内开机自动弹出大人/儿童双选。"
            android:textColor="#90A4AE"
            android:textSize="12sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/layout_rules_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
