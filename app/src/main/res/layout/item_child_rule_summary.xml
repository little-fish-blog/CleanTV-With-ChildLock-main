<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/settings_row_bg"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tv_rule_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="规则名称"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_rule_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="时段：16:00 - 22:00"
        android:textColor="#34C759"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_rule_item_limits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="单次30分 · 休息60分 · 日上限60分"
        android:textColor="#B0BEC5"
        android:textSize="12sp" />

</LinearLayout>
