<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E60D131D"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="请选择本次观看模式"
        android:textColor="#FFFFFFFF"
        android:textSize="36sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_mode_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="当前处于儿童管控生效时段，请选择观看身份"
        android:textColor="#B0C4DE"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 👶 儿童模式卡片 -->
        <LinearLayout
            android:id="@+id/card_child_mode"
            android:layout_width="320dp"
            android:layout_height="220dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/mode_select_card_bg"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👶"
                android:textSize="54sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="儿童模式"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_child_mode_rule_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="定时护眼 · 单次限时"
                android:textColor="#81D4FA"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 👨‍👩‍👧 大人模式卡片 -->
        <LinearLayout
            android:id="@+id/card_adult_mode"
            android:layout_width="320dp"
            android:layout_height="220dp"
            android:background="@drawable/mode_select_card_bg"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👨‍👩‍👧"
                android:textSize="54sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="大人模式"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="需输入密码 · 全功能无限制"
                android:textColor="#FFD54F"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="💡 遥控器方向键左右切换，按 OK 键确定"
        android:textColor="#607D8B"
        android:textSize="14sp" />

</LinearLayout>
